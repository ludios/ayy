// Model-output: Claude Opus 5.5
{
	"files": [
		"index.ts"
	],
	"compilerOptions": {
		// Only ECMAScript, no Node or DOM APIs, so that ayy works in any JavaScript runtime
		"lib": ["esnext"],
		"types": [],
		"module": "esnext",
		"target": "esnext",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"useUnknownInCatchVariables": false,
		// Generate d.ts files
		"declaration": true,
	}
}
